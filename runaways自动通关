local function refreshBtn()
	if isRunning then
		btn.Text = "关闭自动刷金币"
		btn.BackgroundColor3 = Color3.fromRGB(160, 90, 30)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		sub.Text = "状态：运行中"
	else
		btn.Text = "开启自动刷金币"
		btn.BackgroundColor3 = Color3.fromRGB(70, 55, 30)
		btn.TextColor3 = Color3.fromRGB(255, 230, 180)
		sub.Text = "状态：已停止"
	end
end

btn.MouseButton1Click:Connect(function()
	if isRunning then
		stopFarm()
	else
		startFarm()
	end
	refreshBtn()
end)

local function fullStop()
	stopFarm()
	disconnectAll()
	pcall(function()
		if gui then
			gui:Destroy()
		end
	end)
	getgenv().WuRunawaysStop = nil
end

getgenv().WuRunawaysStop = fullStop

