local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local UserInputService = game:GetService("UserInputService")
local LocalPlayer = Players.LocalPlayer

local SCRIPT_FILE = "Runaways_AutoGold_Fixed.lua"
local OFF_FILE = "Runaways_AutoGold_OFF.txt"
local GITHUB_RAW = nil -- 若要用 GitHub，填 raw 链接；nil = 只用本地文件

local isRunning = false
local isVictoryRunning = false
local RemoteEvent = nil
local SERVER_ENTRY_TIME = tick()
local connections = {}
local loopsAlive = false

local function track(conn)
	if conn then
		connections[#connections + 1] = conn
	end
	return conn
end

local function disconnectAll()
	for _, c in ipairs(connections) do
		pcall(function()
			c:Disconnect()
		end)
	end
	table.clear(connections)
end

local function isUserDisabled()
	local off = false
	pcall(function()
		if isfile and isfile(OFF_FILE) then
			local c = tostring(readfile(OFF_FILE) or "")
			if c == "1" or c:lower():find("off") or c == "true" then
				off = true
			end
		end
	end)
	return off
end

local function setUserDisabled(disabled)
	pcall(function()
		if not writefile then
			return
		end
		if disabled then
			writefile(OFF_FILE, "1")
		else
			if delfile and isfile and isfile(OFF_FILE) then
				pcall(delfile, OFF_FILE)
			else
				writefile(OFF_FILE, "0")
			end
		end
	end)
end

local function getQueueFn()
	for _, fn in ipairs({
		queue_on_teleport,
		syn and syn.queue_on_teleport,
		fluxus and fluxus.queue_on_teleport,
		Krnl and Krnl.queue_on_teleport,
		getgenv and getgenv().queue_on_teleport,
	}) do
		if typeof(fn) == "function" then
			return fn
		end
	end
	return nil
end

-- 只登记一次跳服重载，避免每秒 queue 导致失控
local queuedOnce = false
local function queueReloadOnce()
	if queuedOnce or isUserDisabled() then
		return
	end
	local q = getQueueFn()
	if not q then
		return
	end
	local payload
	if GITHUB_RAW and GITHUB_RAW ~= "" then
		payload = string.format([[
repeat task.wait() until game:IsLoaded()
pcall(function()
	if isfile and isfile("%s") then
		local c = tostring(readfile("%s") or "")
		if c == "1" or c:lower():find("off") or c == "true" then return end
	end
	loadstring(game:HttpGet("%s"))()
end)
]], OFF_FILE, OFF_FILE, GITHUB_RAW)
	else
		payload = string.format([[
repeat task.wait() until game:IsLoaded()
pcall(function()
	if isfile and isfile("%s") then
		local c = tostring(readfile("%s") or "")
		if c == "1" or c:lower():find("off") or c == "true" then return end
	end
	if isfile and isfile("%s") then
		loadstring(readfile("%s"))()
	end
end)
]], OFF_FILE, OFF_FILE, SCRIPT_FILE, SCRIPT_FILE)
	end
	local ok = pcall(q, payload)
	if ok then
		queuedOnce = true
		print("[巫script] 已登记跳服重载（仅一次）")
	end
end

local function bindRemote()
	if RemoteEvent then
		return true
	end
	pcall(function()
		local fc = ReplicatedStorage:FindFirstChild("FlowClient") or ReplicatedStorage:WaitForChild("FlowClient", 8)
		local runner = fc and (fc:FindFirstChild("ClientRunner") or fc:WaitForChild("ClientRunner", 6))
		RemoteEvent = runner and (runner:FindFirstChild("Event") or runner:WaitForChild("Event", 6))
	end)
	return RemoteEvent ~= nil
end

local function fireReplay()
	if not RemoteEvent then
		bindRemote()
	end
	if RemoteEvent then
		pcall(function()
			RemoteEvent:FireServer("GameManager", "Replay")
		end)
	end
end

local function tpTo(cf)
	local character = LocalPlayer.Character
	if not character then
		return
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return
	end
	pcall(function()
		hrp.Anchored = true
		character:PivotTo(cf)
		hrp.AssemblyLinearVelocity = Vector3.zero
		task.wait(0.1)
		hrp.Anchored = false
	end)
end

local function runVictory()
	if isVictoryRunning or not isRunning then
		return
	end
	isVictoryRunning = true
	SERVER_ENTRY_TIME = tick()

	task.spawn(function()
		pcall(function()
			local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
			local hrp = character:WaitForChild("HumanoidRootPart", 8)
			local humanoid = character:WaitForChild("Humanoid", 8)
			if not hrp or not humanoid then
				return
			end

			-- 终点（正常高度）
			local endCF = CFrame.new(1780, 1940, 83615) * CFrame.new(0, 5, 0)
			pcall(function()
				local map = workspace:FindFirstChild("Map")
				local buildings = map and map:FindFirstChild("Buildings")
				local customs = buildings and buildings:FindFirstChild("CustomsFinal")
				if customs then
					local pivot = customs:IsA("Model") and customs:GetPivot() or customs.CFrame
					endCF = pivot * CFrame.new(0, 5, 20)
				end
			end)

			-- 少量路径点，避免狂传卡顿
			local wps = {
				CFrame.new(1780, 1940, 72000),
				CFrame.new(1780, 1940, 78000),
				CFrame.new(1780, 1940, 82000),
				endCF,
			}
			for _, cf in ipairs(wps) do
				if not isRunning then
					return
				end
				tpTo(cf)
				task.wait(0.3)
			end

			local waitDie = 7 - (tick() - SERVER_ENTRY_TIME)
			if waitDie > 0 then
				task.wait(waitDie)
			end
			if not isRunning then
				return
			end

			if humanoid.Health > 0 then
				humanoid.Health = 0
			else
				pcall(function()
					character:BreakJoints()
				end)
			end

			task.wait(0.8)
			local t0 = tick()
			while isRunning and tick() - t0 < 12 do
				fireReplay()
				task.wait(1)
			end
		end)
		isVictoryRunning = false
	end)
end

local function findReplayBtn()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return nil
	end
	local endFrame = pg:FindFirstChild("EndFrame")
	if endFrame then
		local f = endFrame:FindFirstChild("Frame")
		local opt = f and f:FindFirstChild("Options")
		local r = opt and opt:FindFirstChild("Replay")
		if r then
			return r
		end
	end
	for _, d in ipairs(pg:GetDescendants()) do
		if d.Name == "Replay" and d:IsA("GuiButton") then
			return d
		end
	end
	return nil
end

local function startFarm()
	if isRunning then
		return
	end
	setUserDisabled(false)
	isRunning = true
	loopsAlive = true
	queueReloadOnce()
	bindRemote()

	-- 主循环：只开一个
	task.spawn(function()
		while isRunning and loopsAlive do
			if not isVictoryRunning then
				runVictory()
			end
			task.wait(2)
		end
	end)

	-- Replay 检测：降频
	task.spawn(function()
		while isRunning and loopsAlive do
			local b = findReplayBtn()
			if b and b.Visible and b.AbsoluteSize.X > 0 then
				fireReplay()
				task.wait(1.5)
			end
			task.wait(0.6)
		end
	end)
end

local function stopFarm()
	isRunning = false
	isVictoryRunning = false
	loopsAlive = false
	setUserDisabled(true)
end

