--[[
    离家同盟 · 自动刷金币（精简版）
    一键：自动通关 + 自动重播 + 跳服自动重载（固定路径）

    固定路径文件名（执行器工作目录）：
      Runaways_AutoGold_Fixed.lua   ← 脚本缓存
      Runaways_AutoGold.txt         ← 开关配置

    默认 raw 已写好（也可覆盖）：
      getgenv().RunawaysScriptURL = "自定义链接"
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local LocalPlayer = Players.LocalPlayer

-- 固定路径（文件名固定，不改）
local CONFIG_FILE = "Runaways_AutoGold.txt"
local SCRIPT_FILE = "Runaways_AutoGold_Fixed.lua"

local isRunning = false
local isVictoryRunning = false
local RemoteEvent = nil

----------------------------------------------------------------
-- 配置读写
----------------------------------------------------------------
local function saveOn(on)
    pcall(function()
        if writefile then
            writefile(CONFIG_FILE, on and "1" or "0")
        end
    end)
end

local function loadOn()
    local on = false
    pcall(function()
        if isfile and isfile(CONFIG_FILE) then
            on = (tostring(readfile(CONFIG_FILE)):gsub("%s", "") == "1")
        end
    end)
    return on
end

----------------------------------------------------------------
-- 跳服自动重载 = 固定路径 + 可选 URL
----------------------------------------------------------------
local function getQueueFn()
    local list = {
        rawget(_G, "queue_on_teleport"),
        syn and syn.queue_on_teleport,
        fluxus and fluxus.queue_on_teleport,
        Krnl and Krnl.queue_on_teleport,
        getgenv and getgenv().queue_on_teleport,
    }
    for _, fn in ipairs(list) do
        if typeof(fn) == "function" then
            return fn
        end
    end
    return nil
end

local DEFAULT_URL = "https://raw.githubusercontent.com/Minions488/--script/refs/heads/main/runaways%E8%87%AA%E5%8A%A8%E9%80%9A%E5%85%B3"

local function getURL()
    local u = tostring(getgenv().RunawaysScriptURL or getgenv().WuRunawaysURL or "")
    if u ~= "" and #u > 8 then
        return u
    end
    return DEFAULT_URL
end

-- 用 URL 下载源码，写入固定路径
local function cacheScriptFromURL()
    local url = getURL()
    if url == "" or #url < 8 then return false end
    if not writefile then return false end
    local ok, src = pcall(function()
        return game:HttpGet(url)
    end)
    if ok and type(src) == "string" and #src > 50 then
        local wok = pcall(function()
            writefile(SCRIPT_FILE, src)
        end)
        if wok then
            print("[刷金币] 已写入固定路径:", SCRIPT_FILE)
            return true
        end
    end
    return false
end

local function hasFixedScript()
    local ok = false
    pcall(function()
        if isfile and isfile(SCRIPT_FILE) then
            local s = readfile(SCRIPT_FILE)
            ok = type(s) == "string" and #s > 50
        end
    end)
    return ok
end

local function queueReload()
    local q = getQueueFn()
    if not q then
        warn("[刷金币] 无 queue_on_teleport → 请把本脚本放入 Autoexec，文件名建议:")
        warn("  " .. SCRIPT_FILE)
        return false
    end

    -- 有 URL 就先缓存到固定路径
    pcall(cacheScriptFromURL)

    -- 跳服后：优先读固定路径，失败再 HttpGet
    local url = getURL()

    local payload = 'task.spawn(function() local i=0 repeat i=i+1 task.wait(1) until game:IsLoaded() or i>40 task.wait(4) local ok=false pcall(function() if isfile and isfile("'
        .. SCRIPT_FILE
        .. '") then loadstring(readfile("'
        .. SCRIPT_FILE
        .. '"))() ok=true print("[刷金币] 固定路径加载成功") end end) if not ok then pcall(function() local u=getgenv and (getgenv().RunawaysScriptURL or getgenv().WuRunawaysURL) if u and #tostring(u)>8 then loadstring(game:HttpGet(tostring(u)))() print("[刷金币] URL加载成功") end end) end end)'

    local ok, err = pcall(q, payload)
    if ok then
        print("[刷金币] 已登记跳服加载（固定路径: " .. SCRIPT_FILE .. "）")
    else
        warn("[刷金币] queue 失败:", err)
    end

    if url ~= "" and #url > 8 then
        local payload2 = 'task.spawn(function() local i=0 repeat i=i+1 task.wait(1) until game:IsLoaded() or i>40 task.wait(5) pcall(function() loadstring(game:HttpGet("'
            .. url
            .. '"))() end) end)'
        pcall(q, payload2)
    end

    return ok
end

----------------------------------------------------------------
-- 远程
----------------------------------------------------------------
local function bindRemote()
    if RemoteEvent then return true end
    local ok = pcall(function()
        local fc = ReplicatedStorage:FindFirstChild("FlowClient")
            or ReplicatedStorage:WaitForChild("FlowClient", 12)
        local runner = fc and (fc:FindFirstChild("ClientRunner") or fc:WaitForChild("ClientRunner", 8))
        RemoteEvent = runner and (runner:FindFirstChild("Event") or runner:WaitForChild("Event", 8))
    end)
    return ok and RemoteEvent ~= nil
end

local function fireReplay()
    if not RemoteEvent then bindRemote() end
    if RemoteEvent then
        pcall(function()
            RemoteEvent:FireServer("GameManager", "Replay")
        end)
    end
end

----------------------------------------------------------------
-- 通关逻辑（精简自原版 Victory）
----------------------------------------------------------------
local function runVictory()
    if isVictoryRunning then return end
    isVictoryRunning = true

    task.spawn(function()
        local ok, err = pcall(function()
            local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
            local hrp = character:WaitForChild("HumanoidRootPart", 10)
            if not hrp then return end

            local noclipConn = RunService.Stepped:Connect(function()
                if character then
                    for _, part in ipairs(character:GetDescendants()) do
                        if part:IsA("BasePart") then
                            part.CanCollide = false
                        end
                    end
                end
            end)

            local function tp(cf)
                hrp.Anchored = true
                character:PivotTo(cf)
                task.wait(1.2)
                hrp.Anchored = false
            end

            local function firePrompt(prompt)
                if not prompt or not prompt:IsA("ProximityPrompt") then return end
                prompt.RequiresLineOfSight = false
                prompt.MaxActivationDistance = 99999
                prompt.HoldDuration = 0
                if fireproximityprompt then
                    fireproximityprompt(prompt)
                end
            end

            tp(CFrame.new(1780, 1940, 83615) * CFrame.new(0, 5, 0))
            task.wait(0.4)

            local map = workspace:FindFirstChild("Map")
            local buildings = map and map:FindFirstChild("Buildings")
            local customsFinal = buildings and buildings:FindFirstChild("CustomsFinal")

            if customsFinal then
                local pivot = customsFinal:IsA("Model") and customsFinal:GetPivot() or customsFinal.CFrame
                tp(pivot * CFrame.new(0, 5, 20))
            end
            task.wait(0.4)

            local commandDoor = customsFinal
                and customsFinal:FindFirstChild("CustomsBuilding")
                and customsFinal.CustomsBuilding:FindFirstChild("FinalDoor")
                and customsFinal.CustomsBuilding.FinalDoor:FindFirstChild("Command")

            if commandDoor then
                local doorCf = commandDoor:IsA("Model") and commandDoor:GetPivot() or commandDoor.CFrame
                tp(doorCf * CFrame.new(0, 0, 5))
                local btn = commandDoor:FindFirstChild("CommandButton")
                local prompt = btn and btn:FindFirstChildWhichIsA("ProximityPrompt", true)
                if prompt then
                    task.spawn(function()
                        local t0 = tick()
                        while isRunning and isVictoryRunning and tick() - t0 < 60 do
                            firePrompt(prompt)
                            task.wait(0.12)
                        end
                    end)
                end
            end

            task.wait(0.5)
            local t0 = tick()
            while isRunning and isVictoryRunning and tick() - t0 < 90 do
                fireReplay()
                task.wait(0.8)
            end

            if noclipConn then noclipConn:Disconnect() end
        end)
        if not ok then
            warn("[刷金币] 通关出错:", err)
        end
        isVictoryRunning = false
    end)
end

----------------------------------------------------------------
-- 检测结算 Replay 按钮
----------------------------------------------------------------
local function findReplayBtn()
    local pg = LocalPlayer:FindFirstChild("PlayerGui")
    if not pg then return nil end
    local endFrame = pg:FindFirstChild("EndFrame")
    if endFrame then
        local f = endFrame:FindFirstChild("Frame")
        local opt = f and f:FindFirstChild("Options")
        local r = opt and opt:FindFirstChild("Replay")
        if r then return r end
    end
    for _, d in ipairs(pg:GetDescendants()) do
        if d.Name == "Replay" and d:IsA("GuiButton") then
            return d
        end
    end
    return nil
end

----------------------------------------------------------------
-- 主循环
----------------------------------------------------------------
local function startFarm()
    if isRunning then return end
    isRunning = true
    saveOn(true)
    queueReload()
    bindRemote()

    -- 循环：通关 + 重播
    task.spawn(function()
        while isRunning do
            queueReload()
            if not isVictoryRunning then
                runVictory()
            end
            local t0 = tick()
            while isRunning and isVictoryRunning and tick() - t0 < 150 do
                task.wait(1)
            end
            fireReplay()
            task.wait(3)
        end
    end)

    -- 结算界面出现时也重播
    task.spawn(function()
        while isRunning do
            local btn = findReplayBtn()
            if btn and btn.Visible and btn.AbsoluteSize.X > 0 then
                fireReplay()
                task.wait(1.5)
            end
            task.wait(0.5)
        end
    end)

    print("[刷金币] 已开启：通关 + 重播 + 跳服重载登记")
end

local function stopFarm()
    isRunning = false
    saveOn(false)
    print("[刷金币] 已关闭")
end

