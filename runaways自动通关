--[[
    巫script | 离家同盟 · 自动刷（目标约 4080）
    结算参考：行程 + 通缉星 + 4/4 边境
    关闭后写入 OFF 标记，跳服不再自动加载
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local LocalPlayer = Players.LocalPlayer
local SERVER_ENTRY_TIME = tick()

local SCRIPT_FILE = "Runaways_AutoGold_Fixed.lua"
local OFF_FILE = "Runaways_AutoGold_OFF.txt"

local isRunning = false
local isVictoryRunning = false
local RemoteEvent = nil

-- 目标节奏（秒，从本局开始算）
local T_ROUTE_END = 5.5 -- 跑完路径
local T_DIE = 7.0 -- 自杀/等被捕

local function isUserDisabled()
	local off = false
	pcall(function()
		if isfile and isfile(OFF_FILE) then
			local c = tostring(readfile(OFF_FILE) or "")
			if c == "1" or c:lower():find("off") or c == "true" then
				off = true
			end
		end
	end)
	return off
end

local function setUserDisabled(disabled)
	pcall(function()
		if not writefile then
			return
		end
		if disabled then
			writefile(OFF_FILE, "1")
		else
			if isfile and isfile(OFF_FILE) and delfile then
				pcall(delfile, OFF_FILE)
			else
				writefile(OFF_FILE, "0")
			end
		end
	end)
end

local function getQueueFn()
	local list = {
		queue_on_teleport,
		syn and syn.queue_on_teleport,
		fluxus and fluxus.queue_on_teleport,
		Krnl and Krnl.queue_on_teleport,
		getgenv and getgenv().queue_on_teleport,
	}
	for _, fn in ipairs(list) do
		if typeof(fn) == "function" then
			return fn
		end
	end
	return nil
end

----------------------------------------------------------------
-- 内嵌缓存（跳服用，与外层逻辑一致）
----------------------------------------------------------------
local CURRENT_SCRIPT_SOURCE

local function updateLocalCache()
	pcall(function()
		if writefile and CURRENT_SCRIPT_SOURCE then
			writefile(SCRIPT_FILE, CURRENT_SCRIPT_SOURCE)
		end
	end)
end

local function queueReload()
	if isUserDisabled() or not isRunning then
		return false
	end
	local q = getQueueFn()
	if not q then
		return false
	end
	updateLocalCache()
	local payload = [[
repeat task.wait() until game:IsLoaded()
pcall(function()
	if isfile and isfile("Runaways_AutoGold_OFF.txt") then
		local c = tostring(readfile("Runaways_AutoGold_OFF.txt") or "")
		if c == "1" or c:lower():find("off") or c == "true" then return end
	end
	if isfile and isfile("Runaways_AutoGold_Fixed.lua") then
		loadstring(readfile("Runaways_AutoGold_Fixed.lua"))()
	end
end)
]]
	return pcall(q, payload)
end

local function bindRemote()
	if RemoteEvent then
		return true
	end
	pcall(function()
		local fc = ReplicatedStorage:FindFirstChild("FlowClient") or ReplicatedStorage:WaitForChild("FlowClient", 12)
		local runner = fc and (fc:FindFirstChild("ClientRunner") or fc:WaitForChild("ClientRunner", 8))
		RemoteEvent = runner and (runner:FindFirstChild("Event") or runner:WaitForChild("Event", 8))
	end)
	return RemoteEvent ~= nil
end

local function fireReplay()
	if not RemoteEvent then
		bindRemote()
	end
	if RemoteEvent then
		pcall(function()
			RemoteEvent:FireServer("GameManager", "Replay")
		end)
	end
end

local function fireGM(...)
	if not RemoteEvent then
		bindRemote()
	end
	if RemoteEvent then
		local args = { ... }
		pcall(function()
			RemoteEvent:FireServer(unpack(args))
		end)
	end
end

-- 收集边境 / 检查点 / 终点
local function collectRoutePoints()
	local points = {}
	local function addCF(cf, tag)
		if cf then
			points[#points + 1] = { cf = cf, tag = tag or "?" }
		end
	end

	pcall(function()
		local map = workspace:FindFirstChild("Map")
		if not map then
			return
		end
		-- 关键词找边境相关
		local keys = { "border", "Border", "checkpoint", "Checkpoint", "crossing", "Customs", "customs" }
		for _, d in ipairs(map:GetDescendants()) do
			local n = d.Name
			for _, k in ipairs(keys) do
				if string.find(n, k, 1, true) then
					local cf
					pcall(function()
						if d:IsA("Model") then
							cf = d:GetPivot()
						elseif d:IsA("BasePart") then
							cf = d.CFrame
						end
					end)
					if cf then
						addCF(cf * CFrame.new(0, 5, 0), n)
					end
					break
				end
			end
		end
		local buildings = map:FindFirstChild("Buildings")
		local customs = buildings and buildings:FindFirstChild("CustomsFinal")
		if customs then
			local pivot = customs:IsA("Model") and customs:GetPivot() or customs.CFrame
			addCF(pivot * CFrame.new(0, 5, 20), "CustomsFinal")
		end
	end)

	-- 保底路径：沿大致逃跑方向插值（已知终点附近）
	-- 原终点约 (1780, 1940, 83615)，用正常高度
	local endPos = CFrame.new(1780, 1940, 83615)
	if #points < 4 then
		points = {}
		local starts = {
			CFrame.new(1780, 1940, 70000),
			CFrame.new(1780, 1940, 74000),
			CFrame.new(1780, 1940, 78000),
			CFrame.new(1780, 1940, 81000),
			endPos * CFrame.new(0, 5, 0),
		}
		for i, cf in ipairs(starts) do
			addCF(cf, "wp" .. i)
		end
		pcall(function()
			local map = workspace:FindFirstChild("Map")
			local buildings = map and map:FindFirstChild("Buildings")
			local customs = buildings and buildings:FindFirstChild("CustomsFinal")
			if customs then
				local pivot = customs:IsA("Model") and customs:GetPivot() or customs.CFrame
				addCF(pivot * CFrame.new(0, 5, 20), "CustomsFinal")
			end
		end)
	end

	-- 按 Z 大致排序（从近到远到边境）
	table.sort(points, function(a, b)
		return a.cf.Z < b.cf.Z
	end)

	-- 最多取 6 个点，保证快
	if #points > 6 then
		local slim = {}
		local step = (#points - 1) / 5
		for i = 0, 5 do
			local idx = math.floor(i * step) + 1
			slim[#slim + 1] = points[math.clamp(idx, 1, #points)]
		end
		points = slim
	end
	return points
end

local function tpTo(cf)
	local character = LocalPlayer.Character
	if not character then
		return false
	end
	local hrp = character:FindFirstChild("HumanoidRootPart")
	if not hrp then
		return false
	end
	pcall(function()
		hrp.Anchored = true
		character:PivotTo(cf)
		hrp.AssemblyLinearVelocity = Vector3.zero
		task.wait(0.12)
		hrp.Anchored = false
	end)
	return true
end

local function runVictory()
	if isVictoryRunning or not isRunning then
		return
	end
	isVictoryRunning = true

	task.spawn(function()
		local ok, err = pcall(function()
			local character = LocalPlayer.Character or LocalPlayer.CharacterAdded:Wait()
			local hrp = character:WaitForChild("HumanoidRootPart", 10)
			local humanoid = character:WaitForChild("Humanoid", 10)
			if not hrp or not humanoid then
				return
			end

			local points = collectRoutePoints()
			print("[巫script] 路径点:", #points)

			-- 快速点传送，尽量触发边境计数 / 行程
			for i, pt in ipairs(points) do
				if not isRunning then
					return
				end
				tpTo(pt.cf)
				-- 轻微移动，避免纯瞬移不记距离
				pcall(function()
					hrp.CFrame = hrp.CFrame * CFrame.new(0, 0, -8)
				end)
				task.wait(0.35)
			end

			-- 再扫一遍名字含 Border 的 Part 强行踩
			pcall(function()
				local map = workspace:FindFirstChild("Map")
				if not map then
					return
				end
				local n = 0
				for _, d in ipairs(map:GetDescendants()) do
					if n >= 4 then
						break
					end
					if d:IsA("BasePart") and string.lower(d.Name):find("border") then
						n = n + 1
						tpTo(d.CFrame * CFrame.new(0, 5, 0))
						task.wait(0.25)
					end
				end
			end)

			-- 终点海关
			pcall(function()
				local map = workspace:FindFirstChild("Map")
				local buildings = map and map:FindFirstChild("Buildings")
				local customs = buildings and buildings:FindFirstChild("CustomsFinal")
				if customs then
					local pivot = customs:IsA("Model") and customs:GetPivot() or customs.CFrame
					tpTo(pivot * CFrame.new(0, 5, 20))
				else
					tpTo(CFrame.new(1780, 1940, 83615) * CFrame.new(0, 5, 0))
				end
			end)

			-- 等满路径时间
			local left = T_ROUTE_END - (tick() - SERVER_ENTRY_TIME)
			if left > 0 then
				task.wait(left)
			end
			if not isRunning then
				return
			end

			-- 尝试拉通缉 / 结算相关（失败也无妨）
			fireGM("GameManager", "Wanted")
			fireGM("GameManager", "AddWanted")
			fireGM("GameManager", "Capture")
			fireGM("GameManager", "Finish")
			fireGM("GameManager", "BorderCross")

			local leftDie = T_DIE - (tick() - SERVER_ENTRY_TIME)
			if leftDie > 0 then
				task.wait(leftDie)
			end
			if not isRunning then
				return
			end

			-- 自杀触发结算（被捕界面）
			if humanoid and humanoid.Health > 0 then
				humanoid.Health = 0
			else
				pcall(function()
					character:BreakJoints()
				end)
			end

			task.wait(0.8)
			local t0 = tick()
			while isRunning and isVictoryRunning and tick() - t0 < 20 do
				fireReplay()
				task.wait(0.7)
			end
		end)
		if not ok then
			warn("[巫script] 流程:", err)
		end
		isVictoryRunning = false
	end)
end

local function findReplayBtn()
	local pg = LocalPlayer:FindFirstChild("PlayerGui")
	if not pg then
		return nil
	end
	local endFrame = pg:FindFirstChild("EndFrame")
	if endFrame then
		local f = endFrame:FindFirstChild("Frame")
		local opt = f and f:FindFirstChild("Options")
		local r = opt and opt:FindFirstChild("Replay")
		if r then
			return r
		end
	end
	for _, d in ipairs(pg:GetDescendants()) do
		if d.Name == "Replay" and d:IsA("GuiButton") then
			return d
		end
	end
	return nil
end

local function startFarm()
	if isRunning then
		return
	end
	setUserDisabled(false)
	isRunning = true
	SERVER_ENTRY_TIME = tick()
	queueReload()
	bindRemote()

	task.spawn(function()
		while isRunning do
			if isUserDisabled() then
				break
			end
			queueReload()
			if not isVictoryRunning then
				SERVER_ENTRY_TIME = tick()
				runVictory()
			end
			local t0 = tick()
			while isRunning and isVictoryRunning and tick() - t0 < 25 do
				task.wait(0.4)
			end
			if isRunning then
				fireReplay()
			end
			task.wait(1.2)
		end
	end)

	task.spawn(function()
		while isRunning do
			local b = findReplayBtn()
			if b and b.Visible and b.AbsoluteSize.X > 0 then
				fireReplay()
				-- 也试点击
				pcall(function()
					if firesignal then
						firesignal(b.MouseButton1Click)
					end
				end)
				task.wait(1.0)
			end
			task.wait(0.35)
		end
	end)
	print("[巫script] 开启：快速路径 + 结算 + Replay")
end

local function stopFarm()
	isRunning = false
	isVictoryRunning = false
	setUserDisabled(true)
	print("[巫script] 已关闭")
end

