local function getUiParent()
	local ok, h = pcall(function()
		if gethui then
			return gethui()
		end
	end)
	if ok and h then
		return h
	end
	ok, h = pcall(function()
		return game:GetService("CoreGui")
	end)
	if ok and h then
		return h
	end
	return LocalPlayer:WaitForChild("PlayerGui")
end

pcall(function()
	local parent = getUiParent()
	for _, name in ipairs({ "RunawaysAutoGoldUI", "RunawaysAutoGoldUI2" }) do
		local old = parent:FindFirstChild(name)
		if old then
			old:Destroy()
		end
	end
	-- 清 CoreGui / PlayerGui 残留
	pcall(function()
		for _, h in ipairs({ game:GetService("CoreGui"), LocalPlayer.PlayerGui }) do
			local o = h:FindFirstChild("RunawaysAutoGoldUI")
			if o then
				o:Destroy()
			end
		end
	end)
end)

