		btn.Text = "关闭自动刷"
		btn.BackgroundColor3 = Color3.fromRGB(160, 90, 30)
		btn.TextColor3 = Color3.fromRGB(255, 255, 255)
		sub.Text = "运行中：路径/边境 → 结算 → Replay"
	else
		btn.Text = "开启自动刷"
		btn.BackgroundColor3 = Color3.fromRGB(70, 55, 30)
		btn.TextColor3 = Color3.fromRGB(255, 230, 180)
		sub.Text = "已停止（不会跳服自动加载）"
	end
end

